{
  "name": "zio-pdf-scalajs-frontend-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "link:dev": "cd ../.. && sbt -batch \"scalaJsFrontend/fastLinkJS\"",
    "link:prod": "cd ../.. && sbt -batch \"scalaJsFrontend/fullLinkJS\"",
    "dev": "npm run link:dev && vite",
    "build": "npm run link:prod && tsc -b && vite build && npm run check:preview-compat",
    "check:preview-compat": "node scripts/check-preview-compat.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@noble/hashes": "2.3.0",
    "lucide": "1.31.0",
    "pako": "3.0.1",
    "pdfjs-dist": "6.2.108",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
