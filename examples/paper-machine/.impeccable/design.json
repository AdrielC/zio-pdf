  "narrative": {
    "northStar": "Circuit Network Analyzer",
    "overview": "Paper Machine treats PDF structure as something a person can probe. A navy measurement field, electric-yellow signals and a cool paper bench give the studio the character of a working instrument. The visual language belongs to this example; it does not define the PDF library's identity.\n\nSturdy Chivo lettering makes actions and sections immediate. Monospace identifies actual syntax and addresses. Dense structural information sits beside calm document surfaces; previews are rendered PDF pages, including the example's synthetic vector artwork.",
    "keyCharacteristics": [
      "Square controls and contiguous, bordered work areas.",
      "Solid selected objects, outlined related objects and orthogonal reference traces.",
      "Restrained depth, reserved for the rendered sheet.",
      "Motion attached to a live connection or a completed assembly."
    ],
    "rules": [
      {
        "name": "The Energized State Rule",
        "body": "Yellow identifies an actionable or connected state. A selected object takes a solid yellow field; related objects retain their field and gain a yellow outline.",
        "section": "colors"
      },
      {
        "name": "The Literal Readout Rule",
        "body": "Reserve monospace for PDF syntax and addresses; use Chivo for names, instructions and actions.",
        "section": "typography"
      },
      {
        "name": "The Sheet Depth Rule",
        "body": "Keep instrument chrome flat; reserve ambient elevation for the rendered page.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep actual PDF previews and literal object addresses attached to their controls.",
      "**Do** distinguish a solid selected node from outlined related nodes.",
      "**Do** preserve local scrolling, keyboard focus and reduced-motion behavior when extending a work area.",
      "**Do** use the larger narrow-screen assembly controls with their established spacing."
    ],
    "donts": [
      "**Don't** introduce rounded card shells around the contiguous instrument panels.",
      "**Don't** use monospace for display headlines or action labels.",
      "**Don't** add ambient shadows to ordinary controls or panel seams.",
      "**Don't** turn sample artwork colors or tiny technical annotations into a general palette or heading scale."
    ]
  }
}
